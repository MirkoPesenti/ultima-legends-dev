<fieldset>
	<legend>Danno</legend>
	<div class="form-group">
		<input type="text" name="damage.formula" id="damage-formula" value="{{effect.damage.formula}}" placeholder="Formula" />
		<select name="damage.type" id="damage.type">
			{{selectOptions ULTIMA.damageTypes selected=effect.damage.type localize=true}}
		</select>
	</div>

	<div class="form-group">
		<label for="status">Status</label>
		<select name="status" id="status" {{#if effect.resting}}disabled{{/if}}>
			<option value="" {{#unless effect.status}}selected{{/unless}}>Nessuno</option>
			{{selectOptions ULTIMA.statuses selected=effect.status localize=true}}
		</select>
	</div>
</fieldset>